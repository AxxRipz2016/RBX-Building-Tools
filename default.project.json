{
  "name": "RBX-Building-Tools",
  "servePort": 8002,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "BT": {
        "$className": "Folder",
        "Launcher": {
          "$path": "Launcher"
        },
        "Payload": {
          "$className": "Folder",
          "Core": {
            "$path": "Core"
          },
          "Tools": {
            "$className": "Folder",
            "$path": "Tools"
          },
          "Loader": {
            "$path": "Loader"
          },
          "SyncAPI_Scripts": {
            "$className": "Folder",
            "SyncModule": {
              "$path": "SyncAPI.lua"
            },
            "LocalEndpoint": {
              "$path": "Support/LocalAPIEndpoint.local.client.lua"
            }
          },
          "Loaded_Scripts": {
            "$className": "Folder",
            "DescendantCounter": {
              "$path": "Support/DescendantCounter.local.client.lua"
            },
            "ReplicationListener": {
              "$path": "Support/ReplicationListener.client.lua"
            }
          },
          "Libraries": {
            "$path": "Libraries",
            "Signal": {
              "$path": "node_modules/@quenty/signal/src/Shared/GoodSignal.lua"
            }
          },
          "Vendor": {
            "$className": "Folder",
            "Roact": {
              "$path": "Vendor/Roact/src"
            }
          },
          "Assets": {
            "$path": "Support/Assets.lua"
          },
          "UI": {
            "$path": "UI"
          },
          "Interfaces": {
            "$className": "Folder",
            "$ignoreUnknownInstances": true
          }
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "BT_LocalLauncher": {
          "$path": "StarterPlayerScripts/BT_LocalLauncher.client.lua"
        }
      }
    }
  }
}
